# LLM Threat Hunting Gem - Environment Configuration
# 
# ⚠️ SECURITY NOTICE: Never commit the .env file to version control.
# Copy this file to .env and fill in your actual credentials.
# The .env file is ignored via .gitignore.

# Google Generative AI API Key
# Obtain from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Output Directory for Generated Reports
OUTPUT_DIR=./output

# Optional: CTI Context Files Directory
CTI_CONTEXT_DIR=./context_files